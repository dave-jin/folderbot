{
  "name": "folderbot",
  "version": "0.2.0",
  "description": "Folder Bot — 내 Mac mini 위에서 사는, 폴더마다 하나씩 붙는 AI 동료들",
  "private": true,
  "type": "module",
  "bin": {
    "folderbot": "bin/folderbot.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:client": "vite build --config vite.client.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "node bin/folderbot.mjs start",
    "dev:host": "node --enable-source-maps dist/host/index.mjs",
    "pack": "node scripts/pack.mjs",
    "qa": "npm run typecheck && npm test && npm run build && node test/smoke.mjs"
  },
  "dependencies": {
    "croner": "10.0.1",
    "web-push": "3.6.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "marked": "18.0.12",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}